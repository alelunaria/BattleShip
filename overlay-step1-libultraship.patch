new file mode 100644
index 0000000..34258c1
--- /dev/null
+++ b/include/ship/utils/overlayMode.h
@@ -0,0 +1,13 @@
+#pragma once
+#include <cstdlib>
+
+// Desktop-overlay mode: a borderless, always-on-top, transparent, click-through
+// window. Enabled by launching with BATTLESHIP_OVERLAY=1 (dev switch; a proper
+// CVar/menu toggle can replace this later).
+inline bool GfxOverlayModeEnabled() {
+    static const bool enabled = [] {
+        const char* v = std::getenv("BATTLESHIP_OVERLAY");
+        return v != nullptr && v[0] != '\0' && v[0] != '0';
+    }();
+    return enabled;
+}
