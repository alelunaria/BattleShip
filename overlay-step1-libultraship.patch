+// Turns the SDL window into a transparent desktop overlay.
+void configureMacOSTransparentOverlay(SDL_Window *window, bool clickThrough) {
+    SDL_SysWMinfo wmInfo;
+    SDL_VERSION(&wmInfo.version);
+    if (!SDL_GetWindowWMInfo(window, &wmInfo)) {
+        return;
+    }
+    NSWindow *nswindow = wmInfo.info.cocoa.window;
+    [nswindow setOpaque:NO];
+    [nswindow setBackgroundColor:[NSColor clearColor]];
+    [nswindow setHasShadow:NO];
+    [nswindow setLevel:NSScreenSaverWindowLevel]; // above the Dock and menu bar
+    [nswindow setCollectionBehavior:NSWindowCollectionBehaviorCanJoinAllSpaces |
+                                    NSWindowCollectionBehaviorStationary |
+                                    NSWindowCollectionBehaviorFullScreenAuxiliary];
+    [nswindow setIgnoresMouseEvents:clickThrough ? YES : NO];
+
+    // Escape hatches: a click-through window can't be clicked or focused, so give the user
+    // a menu-bar Quit item (needs no permissions) and an optional auto-quit timer for testing.
+    static NSStatusItem *sOverlayStatusItem = nil;
+    if (sOverlayStatusItem == nil) {
+        sOverlayStatusItem = [[NSStatusBar systemStatusBar] statusItemWithLength:NSVariableStatusItemLength];
+        sOverlayStatusItem.button.title = @"\u2694 BattleShip";
+        NSMenu *menu = [[NSMenu alloc] init];
+        NSMenuItem *quit = [[NSMenuItem alloc] initWithTitle:@"Quit BattleShip Overlay"
+                                                      action:@selector(terminate:)
+                                               keyEquivalent:@"q"];
+        [quit setTarget:NSApp];
+        [menu addItem:quit];
+        sOverlayStatusItem.menu = menu;
+    }
+    const char *timeoutEnv = getenv("BATTLESHIP_OVERLAY_TIMEOUT");
+    if (timeoutEnv != NULL && atof(timeoutEnv) > 0.0) {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(atof(timeoutEnv) * NSEC_PER_SEC)),
+                       dispatch_get_main_queue(), ^{
+                           [NSApp terminate:nil];
+                       });
+    }
+}
+
 #endif
